{
  "name": "collectorstunetracker",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ctt/web",
    "dev:site": "turbo run dev --filter=@ctt/site",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run migrate -w @ctt/db",
    "db:reset": "npm run reset -w @ctt/db"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "5.9.3"
  }
}
